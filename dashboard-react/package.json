{
  "name": "llmgateway-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts",
    "api:lint": "redocly lint --config ../redocly.yaml ../contracts/openapi.yaml",
    "api:check": "npm run api:lint && npm run api:generate && git diff --exit-code -- src/api/generated/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "dompurify": "^3.4.15",
    "marked": "^15.0.12",
    "openapi-fetch": "^0.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@redocly/cli": "^2.54.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}

# PostgreSQL credentials for the compose stack. Use a long random value.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Exactly 16, 24, or 32 ASCII bytes. Changing this after storing channel keys
# prevents the gateway from decrypting those existing keys.
CHANNEL_KEY_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# Optional runtime settings.
# Public nginx port for the dashboard and same-origin API proxy. Use 443 for a
# public HTTPS deployment (see deployments/nginx.tls.example.conf).
DASHBOARD_PORT=8080
LOG_LEVEL=INFO
UPSTREAM_REQUEST_TIMEOUT=600
UPSTREAM_MAX_ATTEMPTS=3
QUOTA_DEFAULT_MAX_TOKENS=4096
CHANNEL_MIN_ROUTE_BALANCE=0.000000

# Login session lifetime in seconds (default 604800 = 7 days).
SESSION_TTL_SECONDS=604800
# Cookie Secure flag. Keep true behind HTTPS; set false only for plain-HTTP
# local deployments, otherwise the browser will not store the session cookie.
SESSION_COOKIE_SECURE=true
# Set false to disable public self-registration on this deployment.
REGISTRATION_ENABLED=true
# bcrypt cost for password hashing, 4-31 (default 10). Higher is slower and
# stronger.
BCRYPT_COST=10
